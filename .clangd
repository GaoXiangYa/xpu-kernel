# clangd configuration for CUDA sources.
#
# The CMake compilation database uses nvcc-specific flags that clangd's driver
# does not understand. Switch to clang++ and remove those flags, then point
# clangd at the system CUDA installation so headers such as cuda_runtime.h and
# cuda_bf16.h are indexed directly from /usr/local/cuda.
#
# If you use another GPU architecture, update --cuda-gpu-arch below.
If:
  PathMatch: .*\.(cu|cuh)$
CompileFlags:
  Compiler: clang++
  Add:
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_86
    - -Wno-unknown-cuda-version
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code=*
    - -Xcompiler=*
    - -lineinfo
